{
	"name": "obsidian-ultisync",
	"version": "1.0.5",
	"description": "Synchronize selected vault files with a GitHub repository using the GitHub REST API.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"stats": "node scripts/stats.mjs",
		"test": "node --test tests/*.test.ts",
		"link": "node scripts/link-vault.mjs",
		"deploy": "node scripts/deploy-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"github",
		"sync"
	],
	"author": "Sachet",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
